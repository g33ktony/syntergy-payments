DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
AUTH_SECRET="generate-a-long-random-string"
DEFAULT_CURRENCY="MXN"

# One-time bootstrap for existing deployments migrating from the old
# single-shared-password login to per-account, multi-tenant data. On the
# first login attempt after this ships, an Account is created with these
# credentials and every pre-existing Person (which had no account) is
# reattached to it. Safe to remove once that first login has happened.
LEGACY_ACCOUNT_EMAIL="you@example.com"
# Reuses the value of APP_PASSWORD if this isn't set.
LEGACY_ACCOUNT_PASSWORD="choose-a-strong-password"
