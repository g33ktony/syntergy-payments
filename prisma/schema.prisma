generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CASH
  TRANSFER
}

model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  people       Person[]
}

model Person {
  id                      String         @id @default(cuid())
  accountId               String?
  account                 Account?       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                    String
  nickname                String?
  phone                   String?
  howKnown                String?
  preferredPaymentMethod  PaymentMethod?
  bankClabe               String?
  notes                   String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  obligations             Obligation[]

  @@index([accountId])
}

model Obligation {
  id                String        @id @default(cuid())
  personId          String
  person            Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  title             String
  totalAmount       Int
  currency          String        @default("USD")
  installmentCount  Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  installments      Installment[]

  @@index([personId])
}

model Installment {
  id            String      @id @default(cuid())
  obligationId  String
  obligation    Obligation  @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  sequence      Int
  amount        Int
  dueDate        DateTime        @db.Date
  paidAt         DateTime?
  paymentMethod  PaymentMethod?
  createdAt      DateTime        @default(now())
  unassignedPaidAmount Int       @default(0)
  reasons        InstallmentReason[]

  @@unique([obligationId, sequence])
  @@index([dueDate])
  @@index([paidAt])
}

model InstallmentReason {
  id            String      @id @default(cuid())
  installmentId String
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  label         String
  amount        Int
  paidAmount    Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([installmentId])
}
